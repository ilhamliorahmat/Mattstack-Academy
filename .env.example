# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DB_ENCRYPTION_KEY: Secret key used to encrypt SQLite vault files.
DB_ENCRYPTION_KEY="L_ELIXIR_DE_MATHIEU_SECURE_SQLITE_AES256_KEY_2026"

# JWT_SECRET: Secret key for signing stateless auth tokens.
JWT_SECRET="ELIXIR_MATHIEU_JWT_SECRET_TOKEN_2026"

# FTP_CRED: JSON payload secret used by GitHub Actions for automated FTP deployment.
# Format: {"server":"ftp.domain.com","username":"u123","password":"xxx","server_dir":"mattstack.xo.je/htdocs/"}
FTP_CRED=
